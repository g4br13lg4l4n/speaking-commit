# Copia este archivo como .env y llena las llaves. .env nunca se sube al repositorio.

# Claude corrige tus prácticas. Crea la llave en https://platform.claude.com (API Keys).
ANTHROPIC_API_KEY=

# Voz a texto: cualquier servicio compatible con el endpoint de transcripción de OpenAI.
# OpenAI:  STT_URL=https://api.openai.com/v1/audio/transcriptions   STT_MODELO=whisper-1
# Groq:    STT_URL=https://api.groq.com/openai/v1/audio/transcriptions   STT_MODELO=whisper-large-v3
STT_URL=https://api.openai.com/v1/audio/transcriptions
STT_MODELO=whisper-1
STT_API_KEY=

# Opcionales
# PUERTO=4320
# CLAUDE_MODELO=claude-opus-5-5
# MODO_DEMO=1   (transcripción y corrección de ejemplo, sin gastar en APIs)
